{
    "proxy": {
        "host": "0.0.0.0",
        "port": 8000
    },
    "routes": [
        {
            "name": "worker-1",
            "type": "socket",
            "token": "token1",
            "socket": "ws://127.0.0.1:4500"
        },
        {
            "name": "worker-2",
            "type": "socket",
            "token": "token2",
            "socket": "/opt/agentic/worker-2/app-server.sock"
        },
        {
            "name": "worker-3",
            "type": "stdio",
            "token": "token3",
            "command": "copilot",
            "args": ["--acp", "--stdio"]
        },
        {
            "name": "worker-4",
            "type": "tcp",
            "token": "token4",
            "host": "127.0.0.1",
            "port": 3000
        }
    ]
}